{
  "name": "garage-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Babu Awamir Auto Garage Management System",
  "author": "Vevofiks Solutions",
  "main": "electron/main.js",
  "scripts": {
    "dev:next": "next dev",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "dev": "concurrently -k \"npm run dev:next\" \"npm run dev:electron\"",
    "build": "next build",
    "build:electron": "node scripts/build-exe.js && electron-builder --win",
    "build:linux": "node scripts/build-exe.js && electron-builder --linux",
    "start": "next start",
    "reset-password": "node scripts/reset-admin-password.js",
    "lint": "eslint"
  },
  "build": {
    "appId": "com.babuawamir.garage",
    "productName": "babuawamirautogarage",
    "copyright": "Copyright © 2026 Vevofiks Solutions",
    "publish": {
      "provider": "github",
      "owner": "vevofiks",
      "repo": "garage-management-desktop"
    },
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "dist"
    },
    "afterPack": "./scripts/after-pack.js",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/better-sqlite3/**/*"
    ],
    "files": [
      "electron/**/*",
      "package.json",
      "public/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/semver/**/*",
      "node_modules/tiny-typed-emitter/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/app-logo.png",
      "executableName": "babuawamirautogarage",
      "artifactName": "babuawamirautogarage.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "babuawamirautogarage.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@electron/rebuild": "^3.7.2",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^11.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wait-on": "^9.1.0",
    "zod": "^4.4.3"
  }
}
