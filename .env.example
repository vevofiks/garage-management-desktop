# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real tokens.

# Optional. Powers the shadcnio MCP server (.mcp.json) for adding shadcn/ui
# components via the AI agent instead of `npx shadcn@latest add`. Requires a
# shadcn.io Pro account — get your token from your shadcn.io account settings.
# The app runs fine without this; it only unlocks the MCP-based component
# workflow described in README.md.
SHADCNIO_TOKEN=

# Optional Cloud Server URL
# Set this if you deploy your backend API to a remote cloud server
# e.g. NEXT_PUBLIC_API_URL=https://garage-api.yourdomain.com
NEXT_PUBLIC_API_URL=

# Optional Cloud / Custom Database Path or Connection URL
# Set this to specify a custom database location or cloud DB file path
# e.g. DATABASE_URL=/path/to/custom/garage.db
DATABASE_URL=postgresql://neondb_owner:npg_2WfIXydQTn1z@ep-purple-frost-aynhchr1-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require